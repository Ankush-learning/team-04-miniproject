# Emergency Response System - Configuration Example

# Database (PostgreSQL / SQLite fallback)
DATABASE_URL=sqlite+aiosqlite:///emergency_db.sqlite3
# For PostgreSQL: postgresql+asyncpg://postgres:password@localhost:5432/emergency_db

# Application
APP_NAME=Intelligent Emergency Response System
DEBUG=True
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# GIS & Simulation Configuration
DEFAULT_CITY=Metropolis Central
SIMULATION_TICK_SECONDS=2
TRAFFIC_UPDATE_INTERVAL=5
ROUTING_ALGORITHM=A_STAR_CONSTRAINED
