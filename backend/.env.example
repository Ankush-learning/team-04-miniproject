# Intelligent Emergency Response System (IERS) — Configuration Example
# Project: team-04-miniproject
# DO NOT commit actual .env files — this is the example template only.

# ── Operational Database (FastAPI backend) ────────────────────────────────────
# Default: SQLite (zero-credential, works out of the box)
DATABASE_URL=sqlite+aiosqlite:///C:/Projects/Intelligent-Emergency-Response/database/emergency_db.sqlite3

# PostgreSQL (IERS's own container — use this for full PostGIS support):
# DATABASE_URL=postgresql+asyncpg://iers_user:iers_dev_local@localhost:5434/iers_db

# ── IERS PostGIS Container ────────────────────────────────────────────────────
# Container : iers-postgis   (port 5434)
# Database  : iers_db
# User      : iers_user
# Volume    : iers_postgis_data  (independent from any other project)
# Schema    : iers.*
# Start     : docker compose up -d  (from project root)
#
# NOTE: GeoPilot uses a separate container (geopilot-postgis, port 5433).
#       IERS MUST NOT connect to geopilot-postgis.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Intelligent Emergency Response System
DEBUG=True
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# ── GIS & Simulation ──────────────────────────────────────────────────────────
DEFAULT_CITY=Hubballi-Vidyanagar Corridor
SIMULATION_TICK_SECONDS=1
ROUTING_ALGORITHM=DIJKSTRA_CONSTRAINED
GIS_NETWORK_JSON=gis/data/imported_gis_network.json
